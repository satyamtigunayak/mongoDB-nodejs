<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>student data</title>
</head>
<body>
    <h1>STUDENTS DATA</h1>
    <table border="1" cellpadding="8">
        <tr>
            <th>name</th>
            <th>age</th>
            <th>city</th>
        </tr>
         <% students.forEach(student => { %>
            <tr>
                <td><%= student.name %></td>
                <td><%= student.age %></td>
                <td><%= student.city %></td>
            </tr>
        <% }) %>
    </table>
</body>
</html>